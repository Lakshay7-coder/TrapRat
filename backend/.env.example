# Database
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET=change_me_to_32_char_random_string_here_now
JWT_REFRESH_SECRET=change_me_to_another_32_char_string_here_now
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Field encryption (AES-256-GCM - 64 hex chars = 32 bytes)
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FIELD_HMAC_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789

# Identity linking
IDENTITY_HMAC_SALT=unique_salt_per_environment

# Notification (mock)
MOCK_NOTIFICATIONS=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Anomaly thresholds
ANOMALY_EMPLOYER_BULK_THRESHOLD=20
ANOMALY_PLACEMENT_SPIKE_DAYS=7
ANOMALY_RAPID_CONFIRM_MINUTES=5

# Identity linking thresholds
IDENTITY_AUTO_LINK_THRESHOLD=0.90
IDENTITY_REVIEW_THRESHOLD=0.65

# Small-cell suppression
ANALYTICS_MIN_CELL_SIZE=10

# Follow-up cadence (days, comma separated)
FOLLOWUP_CADENCE=30,90,180,365
